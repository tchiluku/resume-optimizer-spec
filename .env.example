# Copy this file to .env.local and fill in values. .env.local is never committed.

# Anthropic API key from https://console.anthropic.com (API billing, separate from a Claude.ai subscription).
# Leave empty to run in demo mode (built-in simulated analysis, no AI).
ANTHROPIC_API_KEY=

# Maximum analyses per day across all visitors (default 200). Best-effort on Vercel: counts reset when an instance restarts.
DAILY_ANALYSIS_CAP=200
